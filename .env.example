# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OpenAI Configuration (para embeddings e chat da consultora)
OPENAI_API_KEY="your-openai-api-key"

# Supabase — use SOMENTE estes tres nomes (sem prefixo NEXT_PUBLIC_).
# URL e ANON_KEY sao entregues ao navegador pelo bloco `env` do next.config.ts.
# Na Vercel elas sao gravadas no build: alterou a variavel, refaca o deploy.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Mercado Pago Configuration
MP_ACCESS_TOKEN="your-access-token"
MP_PUBLIC_KEY="your-public-key"
